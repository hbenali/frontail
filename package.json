{
  "name": "@hbenali/frontail",
  "version": "2.33.0",
  "description": "streaming logs to the browser",
  "homepage": "https://github.com/hbenali/frontail",
  "author": "Houssem Ben Ali <hbenali.tn@gmail.com>",
  "contributors": [
    "Maciej Winnicki <maciej.winnicki@gmail.com> (original author, https://github.com/mthenw/frontail)"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "frontail": "bin/frontail"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "basic-auth-connect": "1.1.0",
    "byline": "5.0.0",
    "CBuffer": "2.2.0",
    "commander": "15.0.0",
    "connect": "3.7.0",
    "cookie": "2.0.1",
    "cookie-parser": "1.4.7",
    "daemon-fix41": "1.1.2",
    "express-session": "1.19.0",
    "fs-tail-stream": "1.1.0",
    "serve-static": "2.2.1",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/sinon": "22.0.0",
    "@yao-pkg/pkg": "6.23.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "30.1.2",
    "mocha": "12.0.3",
    "should": "13.2.3",
    "sinon": "22.1.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "temp": "0.9.4",
    "typescript": "7.0.2"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "NODE_OPTIONS='--no-deprecation' mocha -r should --exit test/*.js",
    "pkg": "pkg --no-bytecode --out-path=dist ."
  },
  "pkg": {
    "assets": [
      "preset/*.json",
      "web/**/*"
    ],
    "targets": [
      "node22-linux-x64",
      "node22-linux-arm64",
      "node22-macos-x64",
      "node22-macos-arm64",
      "node22-win-x64"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "always"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hbenali/frontail.git"
  },
  "keywords": [
    "tail",
    "syslog",
    "realtime",
    "log",
    "devops"
  ],
  "main": "index",
  "preferGlobal": true
}
