{
  "name": "@hbenali/frontail",
  "version": "2.20.0",
  "description": "streaming logs to the browser",
  "homepage": "https://github.com/hbenali/frontail",
  "author": "Houssem Ben Ali <hbenali.tn@gmail.com>",
  "contributors": [
    "Maciej Winnicki <maciej.winnicki@gmail.com> (original author, https://github.com/mthenw/frontail)"
  ],
  "license": "MIT",
  "bin": {
    "frontail": "bin/frontail"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "CBuffer": "0.1.4",
    "basic-auth-connect": "1.0.0",
    "byline": "5.0.0",
    "command-exists": "1.2.8",
    "commander": "3.0.1",
    "configstore": "4.0.0",
    "connect": "3.7.0",
    "cookie": "0.1.0",
    "cookie-parser": "1.4.5",
    "daemon-fix41": "1.1.2",
    "express-session": "1.15.6",
    "fs-tail-stream": "1.1.0",
    "is-docker": "1.1.0",
    "serve-static": "1.14.1",
    "socket.io": "4.8.3",
    "universal-analytics": "0.5.4",
    "untildify": "3.0.2",
    "uuid": "3.3.2"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0",
    "eslint": "~6.8.0",
    "eslint-config-airbnb-base": "~14.0.0",
    "eslint-config-prettier": "^6.10.1",
    "eslint-plugin-import": "~2.20.0",
    "jsdom": "~11.12.0",
    "mocha": "~5.2.0",
    "should": "~3.3.2",
    "sinon": "~1.7.3",
    "supertest": "^3.3.0",
    "temp": "~0.8.1"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "NODE_OPTIONS='--no-deprecation' mocha -r should --exit test/*.js",
    "pkg": "pkg --no-bytecode --out-path=dist ."
  },
  "pkg": {
    "assets": [
      "preset/*.json",
      "web/**/*"
    ],
    "targets": [
      "node22-linux-x64",
      "node22-linux-arm64",
      "node22-macos-x64",
      "node22-macos-arm64",
      "node22-win-x64"
    ]
  },
  "eslintConfig": {
    "extends": [
      "airbnb-base",
      "prettier"
    ],
    "rules": {
      "no-console": "off",
      "strict": "off",
      "implicit-arrow-linebreak": "off"
    },
    "env": {
      "node": true
    },
    "ignorePatterns": [
      "web/assets/tinycon.min.js",
      "web/assets/ansi_up.js"
    ],
    "overrides": [
      {
        "files": [
          "web/assets/app.js"
        ],
        "env": {
          "node": false,
          "browser": true
        },
        "rules": {
          "no-var": "off",
          "vars-on-top": "off",
          "one-var": "off",
          "prefer-const": "off",
          "prefer-template": "off",
          "func-names": "off",
          "no-plusplus": "off",
          "no-underscore-dangle": "off",
          "no-param-reassign": "off",
          "consistent-return": "off",
          "no-use-before-define": "off",
          "no-continue": "off",
          "no-restricted-syntax": "off"
        }
      }
    ]
  },
  "prettier": {
    "singleQuote": true,
    "arrowParens": "always"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hbenali/frontail.git"
  },
  "keywords": [
    "tail",
    "syslog",
    "realtime",
    "log",
    "devops"
  ],
  "main": "index",
  "preferGlobal": true
}
