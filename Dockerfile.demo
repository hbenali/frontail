# Demo image: extends the real frontail image with fake seed logs and a
# background generator, so it can be deployed publicly (e.g. Render's free
# tier) without ever touching real data.
#
# Pinned to a specific tag+digest rather than :latest: Render's build cache
# was observed reusing a stale resolution of :latest across builds, silently
# serving an old release. Bump both the tag and digest here on every release
# (`docker buildx imagetools inspect hbenali/frontail:<tag>` to get the digest).
FROM hbenali/frontail:2.33@sha256:e9197ceec24d5c1a6287507ab8b3b9e574d5c138ee32ccc672c5cba0231c23ab

LABEL org.opencontainers.image.title="frontail-demo" \
      org.opencontainers.image.description="Public frontail demo with fake, continuously-generated logs"

# Needed to seed /demo and chown it; the entrypoint still drops to the
# frontail user via su-exec. Trivy DS-0002 exception: see .trivyignore.yaml.
USER root

COPY demo/seed/ /frontail/demo/seed/
COPY demo/generate-demo-logs.js /frontail/demo/generate-demo-logs.js
COPY demo/docker-entrypoint-demo.sh /frontail/docker-entrypoint-demo.sh

RUN chmod +x /frontail/docker-entrypoint-demo.sh \
 && mkdir -p /demo \
 && cp /frontail/demo/seed/*.log /frontail/demo/seed/*.out /demo/ \
 && chown -R frontail:frontail /demo /frontail/demo

ENTRYPOINT ["/frontail/docker-entrypoint-demo.sh"]
CMD ["/demo/access.log", "/demo/nginx-error.log", "/demo/apache-error.log", "/demo/catalina.out", "/demo/platform.log", "/demo/syslog.log", "/demo/custom.log", "/demo/colored.log", "/demo/json.log", "--number", "60"]
